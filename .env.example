# PeopleDesk Employee Management System - Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env (or 'Copy-Item .env.example .env' on Windows PowerShell)

# Server Port
PORT=5000

# Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# MongoDB Connection URI
# For local MongoDB Community Server:
MONGODB_URI=mongodb://127.0.0.1:27017/PeopleDesk
# For MongoDB Atlas Cloud Cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/peopledesk?retryWrites=true&w=majority

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:3000
